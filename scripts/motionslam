#!/usr/bin/env bash
# MotionSLAM 统一 CLI — 日常只需记这一个入口
set -euo pipefail
SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPTS/.." && pwd)"
CMD="${1:-help}"
shift || true

usage() {
  cat <<EOF
MotionSLAM 统一入口

用法: ./scripts/motionslam <命令>

导航
  nav start     起容器 + 起 Demo 栈（日常一条）
  nav stop      急停并停栈
  nav watch     异常：最近一次栈日志关键事件
  nav watch -f  异常：实时 /demo/mission/event

建图 / 工程
  map start|walk|ensure [--force]
  build | export | fix-time | stop-slam
  go2 api-walk

验收（专项，非日常）
  verify f-series|smoke|h5|step1|step2|step3

示例:
  ./scripts/motionslam nav start
  ./scripts/motionslam nav watch
  ./scripts/motionslam nav stop
EOF
}

case "$CMD" in
  help|-h|--help) usage ;;
  nav)
    SUB="${1:-}"; shift || true
    case "$SUB" in
      start) exec "$SCRIPTS/nav/start_demo_scan_nav.sh" "$@" ;;
      stop) exec "$SCRIPTS/nav/stop_nav.sh" "$@" ;;
      watch)
        FOLLOW=false
        [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]] && FOLLOW=true
        if [[ -f /opt/ros/humble/setup.bash && -f /ws/install/setup.bash ]]; then
          INNER=1
        else
          docker ps --format '{{.Names}}' 2>/dev/null | grep -qx motionslam || {
            echo "ERROR: 容器未运行。先: ./scripts/motionslam nav start" >&2
            exit 1
          }
          INNER=0
        fi
        WATCH_CMD='
          source /opt/ros/humble/setup.bash 2>/dev/null || true
          source /ws/scripts/dev/source_ws_env.sh 2>/dev/null || true
          LOG=$(ls -t /ws/logs/demo_scan_nav_*.log 2>/dev/null | head -1 || true)
          echo "log=${LOG:-none}"
          if [[ -n "$LOG" ]]; then
            echo "--- 关键事件 ---"
            grep -E "pct_nav_started|pct_path_received|subgoal_dispatched|subgoal_reached|plan_fail|alignment_timeout|replan_fuse|glass_trap|-99\\.40|Skip duplicate" "$LOG" | tail -40 || echo "(无匹配)"
          fi
        '
        if $FOLLOW; then
          WATCH_CMD+='
            echo "--- 实时 /demo/mission/event (Ctrl+C 停) ---"
            ros2 topic echo /demo/mission/event std_msgs/msg/String
          '
        fi
        if [[ "$INNER" -eq 1 ]]; then
          exec bash -lc "$WATCH_CMD"
        fi
        exec docker exec motionslam bash -lc "$WATCH_CMD"
        ;;
      *) echo "用法: motionslam nav start|stop|watch [-f]" >&2; exit 1 ;;
    esac
    ;;
  map)
    SUB="${1:-}"; shift || true
    case "$SUB" in
      start) exec "$SCRIPTS/map/start_mapping.sh" "$@" ;;
      walk) exec "$SCRIPTS/map/start_mapping_walk.sh" "$@" ;;
      ensure)
        FORCE=""
        for a in "$@"; do [[ "$a" == "--force" ]] && FORCE="--force"; done
        exec "$SCRIPTS/map/ensure_nav_maps.sh" $FORCE
        ;;
      *) echo "用法: motionslam map start|walk|ensure [--force]" >&2; exit 1 ;;
    esac
    ;;
  verify)
    SUB="${1:-}"; shift || true
    case "$SUB" in
      f-series|f) exec "$SCRIPTS/verify/verify_f_series.sh" "$@" ;;
      smoke|e2e) exec "$SCRIPTS/verify/verify_f_series.sh" --smoke "$@" ;;
      h5)
        DIST=2
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --distance) DIST="${2:?}"; shift 2 ;;
            *) shift ;;
          esac
        done
        # shellcheck source=/dev/null
        source "$SCRIPTS/dev/source_ws_env.sh" 2>/dev/null || {
          source /opt/ros/humble/setup.bash
          source "$ROOT/install/setup.bash"
          [[ -f "$ROOT/scan_planner_ws/install/setup.bash" ]] && source "$ROOT/scan_planner_ws/install/setup.bash"
        }
        exec python3 "$SCRIPTS/verify/verify_scan_planner_h5.py" --distance "$DIST"
        ;;
      h5-docker)
        DIST="${1:-3}"
        exec "$SCRIPTS/verify/_h5_docker_test.sh" "$DIST"
        ;;
      step1)
        exec "$SCRIPTS/verify/verify_step1_lean_baseline.sh" "$@"
        ;;
      step1-soak)
        exec "$SCRIPTS/verify/verify_step1_soak.sh" "$@"
        ;;
      step2)
        exec "$SCRIPTS/verify/verify_step2_semantic_nav.sh" "$@"
        ;;
      step2-complete)
        exec "$SCRIPTS/verify/verify_step2_complete.sh" "$@"
        ;;
      step3)
        exec "$SCRIPTS/verify/verify_step3_semantic_search.sh" "$@"
        ;;
      step3-loop)
        exec "$SCRIPTS/verify/verify_step3_search_loop.sh" "$@"
        ;;
      *) echo "用法: motionslam verify ...|step3|step3-loop" >&2; exit 1 ;;
    esac
    ;;
  build) exec "$SCRIPTS/dev/build_ws.sh" "$@" ;;
  edge)
    SUB="${1:-}"; shift || true
    case "$SUB" in
      planner)
        exec python3 "$SCRIPTS/offline/edge_mvpi1_planner.py" "$@"
        ;;
      *) echo "用法: motionslam edge planner [--start-search ...]" >&2; exit 1 ;;
    esac
    ;;
  export) exec "$SCRIPTS/ops/export_go2_evidence.sh" "$@" ;;
  fix-time) exec "$SCRIPTS/ops/fix_system_time.sh" "$@" ;;
  stop-slam) exec "$SCRIPTS/map/stop_unitree_slam.sh" "$@" ;;
  go2)
    SUB="${1:-}"; shift || true
    case "$SUB" in
      api-walk)
        docker ps --format '{{.Names}}' | grep -qx motionslam || {
          echo "请先: ./scripts/motionslam nav start" >&2; exit 1
        }
        docker exec motionslam bash -lc \
          'source /opt/ros/humble/setup.bash && source /ws/install/setup.bash && ros2 run motionslam_pipeline enable_go2_api_walk'
        echo "OK: 已切 API。开栈: ./scripts/motionslam nav start"
        ;;
      *) echo "用法: motionslam go2 api-walk" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "未知命令: $CMD" >&2
    usage >&2
    exit 1
    ;;
esac
