+void GridMap::virtualObstacleCallback(const sensor_msgs::msg::PointCloud2::ConstSharedPtr& msg)
+{
+  if (!msg || msg->width * msg->height == 0)
+    return;
+
+  if (!msg->header.frame_id.empty() && msg->header.frame_id != mp_.frame_id_)
+  {
+    RCLCPP_WARN_THROTTLE(
+        node_->get_logger(), *node_->get_clock(), 3000,
+        "[GridMap] virtual obstacle frame '%s' != grid frame '%s'",
+        msg->header.frame_id.c_str(), mp_.frame_id_.c_str());
+  }
+
+  pcl::PointCloud<pcl::PointXYZ> cloud;
+  pcl::fromROSMsg(*msg, cloud);
+  int injected = 0;
+  for (const auto& point : cloud.points)
+  {
+    if (!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z))
+      continue;
+    Eigen::Vector3d pos(point.x, point.y, point.z);
+    if (!isInMap(pos))
+      continue;
+    setOccupied(pos);
+    ++injected;
+  }
+
+  if (injected > 0)
+  {
+    RCLCPP_INFO_THROTTLE(
+        node_->get_logger(), *node_->get_clock(), 2000,
+        "[GridMap] injected %d virtual occupied voxels from %s",
+        injected, virtual_obstacle_topic_.c_str());
+  }
+}
