+  bool SCANPlannerManager::computeLocalTarget(
+      const Eigen::Vector3d &start_pos,
+      Eigen::Vector3d &target_pos,
+      Eigen::Vector3d &target_vel)
+  {
+    if (global_data_.global_duration_ <= 0.0 || pp_.max_vel_ <= 0.0)
+      return false;
+
+    const double time_step =
+        std::max(0.01, pp_.planning_horizon_ / 20.0 / pp_.max_vel_);
+    double nearest_distance = std::numeric_limits<double>::max();
+    double nearest_time = global_data_.last_progress_time_;
+    double target_time = global_data_.global_duration_;
+    target_pos = global_data_.getPosition(target_time);
+
+    for (double time = global_data_.last_progress_time_;
+         time <= global_data_.global_duration_; time += time_step)
+    {
+      const Eigen::Vector3d point = global_data_.getPosition(time);
+      const double distance = (point - start_pos).norm();
+      if (distance < nearest_distance)
+      {
+        nearest_distance = distance;
+        nearest_time = time;
+      }
+      if (distance >= pp_.planning_horizon_)
+      {
+        target_pos = point;
+        target_time = time;
+        break;
+      }
+    }
+    global_data_.last_progress_time_ = nearest_time;
+
+    const auto occupancy = [this, &start_pos](const Eigen::Vector3d &point) {
+      const Eigen::Vector2d direction = point.head<2>() - start_pos.head<2>();
+      const double yaw = direction.squaredNorm() > 1e-8 ?
+          std::atan2(direction.y(), direction.x()) : 0.0;
+      return grid_map_->getInflateOccupancy(point, yaw);
+    };
+    if (occupancy(target_pos) != 0)
+    {
+      bool found = false;
+      for (double offset = 0.0; offset <= global_data_.global_duration_;
+           offset += time_step)
+      {
+        for (const double candidate_time :
+             {target_time + offset, target_time - offset})
+        {
+          if (candidate_time < nearest_time ||
+              candidate_time > global_data_.global_duration_)
+            continue;
+          const Eigen::Vector3d candidate =
+              global_data_.getPosition(candidate_time);
+          if (occupancy(candidate) == 0)
+          {
+            target_pos = candidate;
+            target_time = candidate_time;
+            found = true;
+            break;
+          }
+        }
+        if (found)
+          break;
+      }
+      if (!found)
+        return false;
+    }
+
+    const Eigen::Vector3d final_position =
+        global_data_.getPosition(global_data_.global_duration_);
+    const double braking_distance =
+        pp_.max_vel_ * pp_.max_vel_ / (2.0 * std::max(pp_.max_acc_, 1e-6));
+    target_vel = (final_position - target_pos).norm() < braking_distance ?
+        Eigen::Vector3d::Zero() : global_data_.getVelocity(target_time);
+    return true;
+  }
+
+  bool SCANPlannerManager::replanFromState(
+      const Eigen::Vector3d &start_pos,
+      const Eigen::Vector3d &start_vel,
+      const Eigen::Vector3d &start_acc,
+      bool random_initialization)
+  {
+    Eigen::Vector3d target_pos;
+    Eigen::Vector3d target_vel;
+    if (!computeLocalTarget(start_pos, target_pos, target_vel))
+      return false;
+    return reboundReplan(
+        start_pos, start_vel, start_acc, target_pos, target_vel,
+        first_replan_, random_initialization);
+  }
+
+  bool SCANPlannerManager::isLocalTrajectoryCollisionFree(
+      const rclcpp::Time &now, double lookahead_seconds)
+  {
+    if (!hasLocalTrajectory())
+      return false;
+    const double current_time = std::clamp(
+        (now - local_data_.start_time_).seconds(), 0.0, local_data_.duration_);
+    const double end_time = lookahead_seconds < 0.0 ?
+        local_data_.duration_ :
+        std::min(local_data_.duration_, current_time + lookahead_seconds);
+    for (double time = current_time; time <= end_time + 1e-6; time += 0.02)
+    {
+      const double next_time = std::min(end_time, time + 0.02);
