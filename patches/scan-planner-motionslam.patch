+
+void GridMap::integratePointCloud(
+    const std::vector<Eigen::Vector3d> &points,
+    const Eigen::Vector3d &sensor_position,
+    const Eigen::Quaterniond &sensor_orientation,
+    bool cloud_is_world)
+{
+  if (!std::isfinite(sensor_position.x()) || !std::isfinite(sensor_position.y()) ||
+      !std::isfinite(sensor_position.z()))
+    return;
+
+  md_.ray_pos_ = sensor_position;
+  md_.ray_q_ = sensor_orientation.norm() > 1e-6
+                  ? sensor_orientation.normalized()
+                  : Eigen::Quaterniond::Identity();
+  md_.has_ray_pose_ = true;
+  md_.has_cloud_ = true;
+  updateSlidingMap(sensor_position);
+  md_.proj_points_cnt = 0;
+
+  const Eigen::Matrix3d sensor_rotation = md_.ray_q_.toRotationMatrix();
+  for (const auto &point : points)
+  {
+    if (!point.allFinite())
+      continue;
+    const Eigen::Vector3d point_world =
+        cloud_is_world ? point : sensor_rotation * point + sensor_position;
+    const Eigen::Vector3d delta = point_world - sensor_position;
+    const double ray_length = delta.norm();
+    const double relative_z = point_world.z() - mp_.ground_height_;
+    if (relative_z < mp_.obstacle_height_min_ ||
+        relative_z > mp_.obstacle_height_max_ ||
+        ray_length < mp_.min_cloud_range_ ||
+        ray_length > mp_.max_ray_length_)
+      continue;
+    if (std::abs(delta.x()) > mp_.local_update_range_.x() ||
+        std::abs(delta.y()) > mp_.local_update_range_.y() ||
+        std::abs(delta.z()) > mp_.local_update_range_.z())
+      continue;
+
+    if (md_.proj_points_cnt >= static_cast<int>(md_.proj_points_.size()))
+      md_.proj_points_.push_back(point_world);
+    else
+      md_.proj_points_[md_.proj_points_cnt] = point_world;
+    ++md_.proj_points_cnt;
+  }
+
+  if (md_.proj_points_cnt > 0)
+  {
+    md_.use_cloud_update_ = true;
+    md_.occ_need_update_ = true;
+    updateOccupancyCallback();
+  }
+}
